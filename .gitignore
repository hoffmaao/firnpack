# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# --- VTK output ---
# The test/ scripts write these into whatever directory they are run from.
*.pvd
*.vtu

# --- Environments ---
venv*/
.venv/
env/

# --- Parking lot -------------------------------------------------------------
# Everything that is not part of the four-part structure (src/firnpack, test,
# tutorials, doc) lives here: superseded run outputs, staged raw data, and the
# South Pole script/log history that predates the shared engine. Untracked but
# NOT deleted, and every file remains recoverable from git history (see the
# commits before this one). Nothing here is on the paper's critical path.
archive/

# --- Large / regenerable data (documented for download; not tracked) ---
*.nc
*.h5
*.hdf5
*.npz
*.mat
*.grib
# Raw upstream downloads a tutorial's staging scripts read (FIRNCOVER_H5 and
# friends); the curated CSVs they emit into data/ are what gets tracked.
tutorials/*/data/raw/
*_raw.csv

# --- Figures (always rebuilt from output/ by each tutorial's plot.py) ---
*.png
*.pdf
*.svg
*.jpg
figures/
tutorials/**/figures/

# --- Run artifacts: each tutorial's output/ holds the expensive MAP JSONs
#     (and .h5 checkpoints) produced by run.py. ---
*_checkpoint/
*_optimisation_checkpoint/
nohup.out
*.log
tutorials/*/logs/
outputs/
outputs_*/
# Ignore the CONTENTS, not the directory itself: git will not descend into an
# excluded directory, so a "tutorials/**/output/" rule would make the
# negations below unreachable.
tutorials/**/output/*

# Keep: the frozen reference MAPs. These are results by provenance but INPUTS by
# use -- tutorials/southpole/run.py warm-starts from r8, and the southpole/summit
# plot scripts read them to compare against. They are small, not cheaply
# regenerable (hours of optimisation), and the paper's flagship numbers.
!tutorials/southpole/output/sp_joint_r8.json
!tutorials/southpole/output/usp50_k_snow_fit.json

# --- Archives ---
*.zip
*.tar
*.tar.gz
*.tgz

# --- Keep: small curated observation CSVs (reproducibility) ---
!tutorials/**/data/
!tutorials/**/data/*.csv

# --- Local agent state ---
.claude/
CLAUDE.md
