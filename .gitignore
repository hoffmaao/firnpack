# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# --- Environments ---
venv*/
.venv/
env/

# --- Large / regenerable data (documented for download; not tracked) ---
*.nc
*.h5
*.hdf5
*.npz
*.mat
*.grib

# --- Figures (always rebuilt from results/ by the plot_*.py scripts) ---
*.png
*.pdf
*.svg
*.jpg
figures/
tutorials/**/figures/
test/**/figures/

# --- Model outputs (regenerated by scripts; results/ = expensive MAP JSONs) ---
*_checkpoint/
*_optimisation_checkpoint/
nohup.out
outputs/
outputs_*/
test/**/results/
tutorials/**/results/

# --- Archives ---
*.zip
*.tar
*.tar.gz
*.tgz

# --- Raw scraped/downloaded sources (large; provenance in per-site README) ---
test/data/
test/_shared_sources/
test/**/sources/
test/**/data/
test/archive/

# --- Keep: small curated observation CSVs (reproducibility) ---
!test/**/processed/
!test/**/processed/*.csv
!tutorials/**/data/
!tutorials/**/data/*.csv

# --- Local agent state ---
.claude/
