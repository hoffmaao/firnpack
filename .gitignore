# --- Python ---
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/
build/
dist/

# --- Environments ---
venv*/
.venv/
env/

# --- Large / regenerable data (documented for download; not tracked) ---
*.nc
*.h5
*.hdf5
*.npz
*.mat
*.grib

# --- Model outputs (regenerated by scripts) ---
*.png
*.pdf
*_checkpoint/
*_optimisation_checkpoint/
nohup.out
outputs/
outputs_*/
test/**/results/
experiments/**/results/

# --- Archives ---
*.zip
*.tar
*.tar.gz
*.tgz

# --- Raw scraped/downloaded sources (large; provenance in per-site README) ---
test/data/
test/_shared_sources/
test/**/sources/
test/**/data/
test/archive/

# --- Keep: small curated observation CSVs (reproducibility) ---
!test/**/processed/
!test/**/processed/*.csv
!experiments/**/data/
!experiments/**/data/*.csv

# --- Local agent state ---
.claude/
